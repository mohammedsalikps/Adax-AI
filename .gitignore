.env
.env.*
!.env.example

# Build and test output
dist/
*.tsbuildinfo
test-results/
playwright-report/
blob-report/
coverage/
*.log

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Third-party sample images (fetched by scripts/fetch-thermal-samples.mjs; see samples/README)
samples/

