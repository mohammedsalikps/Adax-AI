# ADAXAI MVP local environment.
#
# `npm run setup` copies this file to `.env` and fills every empty *_PASSWORD
# with a random value. `.env` is git-ignored. Never commit real credentials.

NODE_ENV=development

# --- PostgreSQL (local cluster managed by scripts/db.mjs) -------------------
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=adaxai
DB_TEST_NAME=adaxai_test
# Used only by the Playwright end-to-end suite (reset and re-seeded every run).
DB_E2E_NAME=adaxai_e2e
# Cluster superuser: used only by db scripts and migrations.
DB_ADMIN_USER=adaxai_admin
DB_ADMIN_PASSWORD=
# Application role: data access only (no DDL, no superuser).
DB_APP_USER=adaxai_app
DB_APP_PASSWORD=
# Location of the cluster's data directory (git-ignored).
DB_DATA_DIR=.data/pg

# --- Services ----------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=4000
WEB_PORT=5173
THERMAL_HOST=127.0.0.1
THERMAL_PORT=8001
THERMAL_URL=http://127.0.0.1:8001

# --- Sessions ------------------------------------------------------------------
# Secure cookies need HTTPS. Leave unset for local HTTP (defaults to true when
# NODE_ENV=production).
COOKIE_SECURE=

# --- Synthetic demo accounts -----------------------------------------------------
# Password for the seeded demo users (admin, dr.meera, dr.rahul, nurse.anil).
# Generated by `npm run setup`; local development only.
SEED_DEMO_PASSWORD=

# --- Files ---------------------------------------------------------------------
# Uploaded files (git-ignored).
STORAGE_DIR=storage
