# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android release signing — never commit credentials or keystores.
# The keystore itself is kept outside this repository entirely.
android/keystore.properties
*.jks
*.keystore
!android/app/debug.keystore

# Environment files — never commit secrets or local configuration.
# .env.example is the one exception: it documents the required keys
# without holding any values.
.env
.env.*
!.env.example
